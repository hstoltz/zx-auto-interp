# A small scalar-exact phase-free benchmark, NOT a claimed complete presentation.
# Fusion is a family; its verification uses the all-arity lemma.
δ := Z(1,0) ∘ X(0,1)
θ := Z(3,0) ∘ X(0,3)

Sg[p,q,r,s]: (id(q) ⊗ Z(r+1,s)) ∘ (Z(p,q+1) ⊗ id(r)) = Z(p+r,q+s)
Sr[p,q,r,s]: (id(q) ⊗ X(r+1,s)) ∘ (X(p,q+1) ⊗ id(r)) = X(p+r,q+s)

S3L: Z(0,2) = cup
S3R: X(0,2) = cup
Copy: δ ⊗ (Z(1,2) ∘ X(0,1)) = X(0,1) ⊗ X(0,1)
Z0: Z(0,0) = X(0,0)
IV: δ ⊗ θ = id(0)
IV2: Z(0,0) = δ ⊗ δ

B: Z(0,0) ⊗ ((X(2,1) ⊗ X(2,1)) ∘ (id ⊗ swap ⊗ id) ∘ (Z(1,2) ⊗ Z(1,2)))
   = δ ⊗ (Z(1,2) ∘ X(2,1))
